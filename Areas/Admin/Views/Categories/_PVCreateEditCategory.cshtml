@model Web_PC_Builder.Models.Category

@Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

<div class="mb-3">
    @Html.LabelFor(m => m.CategoryName, new { @class = "form-label fw-semibold" })
    @Html.TextBoxFor(m => m.CategoryName, new { @class = "form-control", placeholder = "VD: Laptop Gaming", autofocus = "autofocus" })
    @Html.ValidationMessageFor(m => m.CategoryName, "", new { @class = "text-danger" })
</div>
