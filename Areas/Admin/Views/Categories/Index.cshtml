@model IEnumerable<Web_PC_Builder.Models.Category>
@{
    ViewBag.Title = "Danh mục sản phẩm";
    var counts = ViewBag.ProductCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Danh mục sản phẩm</h3>
    @Html.ActionLink("+ Thêm danh mục", "Create", null, new { @class = "btn btn-gvn" })
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:100px">@Html.DisplayNameFor(m => m.CategoryID)</th>
                    <th>@Html.DisplayNameFor(m => m.CategoryName)</th>
                    <th class="text-center" style="width:140px">Số sản phẩm</th>
                    <th class="text-end" style="width:260px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CategoryID</td>
                        <td class="fw-semibold">@item.CategoryName</td>
                        <td class="text-center">@(counts.ContainsKey(item.CategoryID) ? counts[item.CategoryID] : 0)</td>
                        <td class="text-end">
                            @Html.ActionLink("Xem sản phẩm", "Index", "Products", new { searchTerm = item.CategoryName }, new { @class = "btn btn-sm btn-outline-secondary" })
                            @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-sm btn-outline-primary" })
                            @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-sm btn-outline-danger" })
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Chưa có danh mục nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
