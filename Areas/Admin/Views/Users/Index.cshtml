@model Web_PC_Builder.Models.ViewModel.UserSearchVM
@{
    ViewBag.Title = "Tài khoản quản trị";
    string currentAdmin = Session[AdminAuthorizeAttribute.SessionKey] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Tài khoản quản trị</h3>
    @Html.ActionLink("+ Thêm tài khoản", "Create", null, new { @class = "btn btn-gvn" })
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-md-8">
                <label class="form-label small mb-1" for="searchTerm">Từ khóa</label>
                <input type="text" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control"
                       placeholder="Tên đăng nhập..." />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-dark flex-fill">Tìm</button>
                @Html.ActionLink("Xóa lọc", "Index", null, new { @class = "btn btn-outline-secondary flex-fill" })
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Tên đăng nhập</th>
                    <th style="width:160px">Vai trò</th>
                    <th class="text-end" style="width:320px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Users)
                {
                    bool isMe = string.Equals(item.Username, currentAdmin, StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td class="fw-semibold">
                            @item.Username
                            @if (isMe)
                            {
                                <span class="badge bg-info text-dark ms-1">Bạn</span>
                            }
                        </td>
                        <td><span class="badge bg-danger">Quản trị</span></td>
                        <td class="text-end">
                            @Html.ActionLink("Chi tiết", "Details", new { username = item.Username }, new { @class = "btn btn-sm btn-outline-secondary" })
                            @Html.ActionLink("Đổi mật khẩu", "Edit", new { username = item.Username }, new { @class = "btn btn-sm btn-outline-primary" })
                            @if (!isMe)
                            {
                                @Html.ActionLink("Xóa", "Delete", new { username = item.Username }, new { @class = "btn btn-sm btn-outline-danger" })
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Users.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">Không tìm thấy tài khoản nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        @Html.Partial("_Pager", new PagerVM(Model.Users, p => Url.Action("Index", new
        {
            searchTerm = Model.SearchTerm,
            page = p
        })))
    </div>
</div>
