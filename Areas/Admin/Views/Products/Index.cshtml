@model Web_PC_Builder.Models.ViewModel.ProductSearchVM
@{
    ViewBag.Title = "Quản lý sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Quản lý sản phẩm</h3>
    @Html.ActionLink("+ Thêm sản phẩm", "Create", null, new { @class = "btn btn-gvn" })
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-md-4">
                <label class="form-label small mb-1" for="searchTerm">Từ khóa</label>
                <input type="text" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control"
                       placeholder="Tên, mô tả, thương hiệu, danh mục..." />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="minPrice">Giá từ (đ)</label>
                <input type="number" min="0" step="1" id="minPrice" name="minPrice" value="@(Model.MinPrice.HasValue ? Model.MinPrice.Value.ToString("0") : "")" class="form-control" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="maxPrice">Giá đến (đ)</label>
                <input type="number" min="0" step="1" id="maxPrice" name="maxPrice" value="@(Model.MaxPrice.HasValue ? Model.MaxPrice.Value.ToString("0") : "")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1" for="sortOrder">Sắp xếp</label>
                <select id="sortOrder" name="sortOrder" class="form-select">
                    <option value="" @(string.IsNullOrEmpty(Model.SortOrder) ? "selected" : "")>Mới nhất</option>
                    <option value="name_asc" @(Model.SortOrder == "name_asc" ? "selected" : "")>Tên A → Z</option>
                    <option value="name_desc" @(Model.SortOrder == "name_desc" ? "selected" : "")>Tên Z → A</option>
                    <option value="price_asc" @(Model.SortOrder == "price_asc" ? "selected" : "")>Giá tăng dần</option>
                    <option value="price_desc" @(Model.SortOrder == "price_desc" ? "selected" : "")>Giá giảm dần</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark flex-fill">Tìm</button>
                @Html.ActionLink("Xóa lọc", "Index", null, new { @class = "btn btn-outline-secondary flex-fill" })
            </div>
        }
    </div>
</div>

@Html.Partial("_PVListProduct", Model)
