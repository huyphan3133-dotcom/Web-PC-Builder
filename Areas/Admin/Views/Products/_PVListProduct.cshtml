
@model Web_PC_Builder.Models.ViewModel.ProductSearchVM

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width:70px">Ảnh</th>
                    <th style="width:70px">Mã</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Thương hiệu</th>
                    <th class="text-end">Giá bán</th>
                    <th class="text-end" style="width:110px">Tồn kho</th>
                    <th class="text-end" style="width:250px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td><img src="@Url.ProductImage(item.ProductImage)" alt="" class="thumb" /></td>
                        <td>@item.ProductID</td>
                        <td class="fw-semibold">@item.ProductName</td>
                        <td>@item.Category.CategoryName</td>
                        <td>@item.Brand</td>
                        <td class="text-end">
                            <div class="fw-semibold">@AppHelper.Vnd(item.ProductPrice)</div>
                            @if (item.OldPrice.HasValue && item.OldPrice.Value > item.ProductPrice)
                            {
                                <div class="price-old">@AppHelper.Vnd(item.OldPrice)</div>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.Stock <= 0)
                            {
                                <span class="badge text-bg-danger">Hết hàng</span>
                            }
                            else if (item.Stock <= 5)
                            {
                                <span class="fw-semibold" style="color:#e67e22">@item.Stock</span>
                                <div class="small" style="color:#e67e22">sắp hết</div>
                            }
                            else
                            {
                                <span class="fw-semibold">@item.Stock</span>
                            }
                        </td>
                        <td class="text-end">
                            @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-sm btn-outline-secondary" })
                            @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-sm btn-outline-primary" })
                            @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-sm btn-outline-danger" })
                        </td>
                    </tr>
                }
                @if (!Model.Products.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Không tìm thấy sản phẩm nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        @Html.Partial("_Pager", new PagerVM(Model.Products, p => Url.Action("Index", new
        {
            searchTerm = Model.SearchTerm,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice,
            sortOrder = Model.SortOrder,
            page = p
        })))
    </div>
</div>