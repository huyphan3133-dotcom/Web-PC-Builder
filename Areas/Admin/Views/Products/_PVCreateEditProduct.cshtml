@model Web_PC_Builder.Models.Product

@Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })
@Html.HiddenFor(m => m.ProductImage)

<div class="row g-3">
    <div class="col-md-8">
        <div class="mb-3">
            @Html.LabelFor(m => m.ProductName, new { @class = "form-label fw-semibold" })
            @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", autofocus = "autofocus" })
            @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "text-danger" })
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.CategoryID, new { @class = "form-label fw-semibold" })
                @Html.DropDownListFor(m => m.CategoryID, (SelectList)ViewBag.Categories, "-- Chọn danh mục --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.CategoryID, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.Brand, new { @class = "form-label fw-semibold" })
                @Html.TextBoxFor(m => m.Brand, new { @class = "form-control", placeholder = "VD: ASUS, MSI, Logitech..." })
                @Html.ValidationMessageFor(m => m.Brand, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.ProductPrice, new { @class = "form-label fw-semibold" })
                <div class="input-group">
                    @Html.TextBoxFor(m => m.ProductPrice, "{0:0.##}", new { @class = "form-control", inputmode = "numeric" })
                    <span class="input-group-text">đ</span>
                </div>
                @Html.ValidationMessageFor(m => m.ProductPrice, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.OldPrice, new { @class = "form-label fw-semibold" })
                <div class="input-group">
                    @Html.TextBoxFor(m => m.OldPrice, "{0:0.##}", new { @class = "form-control", inputmode = "numeric", placeholder = "Để trống nếu không giảm giá" })
                    <span class="input-group-text">đ</span>
                </div>
                @Html.ValidationMessageFor(m => m.OldPrice, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                @Html.LabelFor(m => m.Stock, "Tồn kho", new { @class = "form-label fw-semibold" })
                <div class="input-group">
                    @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number", min = 0, step = 1, inputmode = "numeric", placeholder = "Số lượng còn trong kho" })
                    <span class="input-group-text">sản phẩm</span>
                </div>
                @Html.ValidationMessageFor(m => m.Stock, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.ProductDescription, new { @class = "form-label fw-semibold" })
            @Html.TextAreaFor(m => m.ProductDescription, 8, 20, new { @class = "form-control", placeholder = "Mỗi dòng một thông số, VD:\nCPU: Intel Core i5-12400F\nRAM: 16GB DDR4" })
            @Html.ValidationMessageFor(m => m.ProductDescription, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="col-md-4">
        <label class="form-label fw-semibold">Ảnh sản phẩm</label>
        <div class="text-center mb-2">
            <img id="imgPreview" src="@Url.ProductImage(Model.ProductImage)" alt="Ảnh sản phẩm" class="thumb-lg" />
        </div>
        <input type="file" name="UploadImg" id="UploadImg" class="form-control" accept="image/*" />
        <div class="form-text">jpg, png, gif, webp, svg - tối đa 5 MB. Bỏ trống để giữ ảnh hiện tại.</div>
        @Html.ValidationMessage("UploadImg", "", new { @class = "text-danger" })
    </div>
</div>

<script>
    // Xem trước ảnh ngay khi chọn file
    (function () {
        var input = document.getElementById('UploadImg');
        var img = document.getElementById('imgPreview');
        if (!input || !img || !window.FileReader) { return; }
        input.addEventListener('change', function () {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) { img.src = e.target.result; };
                reader.readAsDataURL(input.files[0]);
            }
        });
    })();
</script>
