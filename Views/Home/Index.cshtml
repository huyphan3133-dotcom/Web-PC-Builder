@{
    ViewBag.Title = "Trang chủ";
    var sp = Url.Action("Home","Product");   // link tạm tới trang danh mục
}
<main>
    <style>
        .dm-overlay {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,.5);
            z-index: 998;
            display: none;
        }

        .dm-open .dm-overlay {
            display: block;
        }

        .dm-open .side {
            position: relative;
            z-index: 999;
        }

        .side a.dm-active {
            background: #f1f1f1;
            color: #d70018;
            border-radius: 8px;
        }

        .mm {
            position: absolute;
            z-index: 99999;
            display: none;
            background: #fff;
            border-radius: 12px;
            padding: 24px 28px;
            box-shadow: 0 8px 30px rgba(0,0,0,.18);
            box-sizing: border-box;
            min-width: 560px;
        }

            .mm h3 {
                margin: 0 0 22px;
                font-size: 22px;
                color: #222;
                display: flex;
                justify-content: space-between;
                align-items: baseline;
            }

                .mm h3 a {
                    color: #d70018;
                    font-size: 14px;
                    font-weight: 600;
                    text-decoration: none;
                }

        .mm-cols {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .mm-g {
            margin-bottom: 22px;
        }

        .mm a.t {
            display: block;
            font-weight: 700;
            color: #222;
            margin-bottom: 10px;
            text-decoration: none;
        }

        .mm a.i {
            display: block;
            padding: 6px 0;
            color: #444;
            font-size: 15px;
            text-decoration: none;
        }

        .mm a:hover {
            color: #d70018;
        }

        .mm-none {
            color: #777;
            padding: 6px 0;
        }
    </style>

    <div class="dm-overlay" id="dm-overlay"></div>

    <script>
    (function () {
        /* ===== CẤU HÌNH ===== */
        var BUILDPC = '@Url.Action("Home", "PCBuilder")';
        var NO_HOVER = ['Thu cũ đổi mới'];               // rê chuột: không hiện bảng
        var PLAIN = ['Dịch vụ và thông tin khác'];       // link tạm "#", không có "Xem tất cả"

        // Mỗi cột gồm nhiều nhóm; mỗi nhóm = [tiêu đề, mục 1, mục 2, ...]
        // Danh mục KHÔNG có ở đây sẽ hiện "Chưa có thêm thông tin về danh mục này."
        var MENU = {
            'Laptop': [
                [['Thương hiệu', 'ACER', 'ASUS']],
                [['Giá bán', 'Dưới 20 triệu', 'Từ 20 đến 30 triệu']],
                [['ACER', 'Aspire Series', 'Swift Series']],
                [['ASUS', 'Vivobook Series', 'ExpertBook Series']]
            ],
            'Laptop Gaming': [
                [['Thương hiệu', 'ACER', 'ASUS']],
                [['Giá bán', 'Dưới 30 triệu', 'Từ 30 đến 50 triệu']],
                [['ACER', 'Aspire 7 Series', 'Nitro Series']],
                [['ASUS', 'V16 Series']]
            ],
            'PC GVN': [
                [['PC theo CPU', 'PC I5', 'PC I7', 'PC Ultra 9']],
                [['PC theo giá', 'Dưới 20 triệu', 'Từ 70 đến 100 triệu', 'Trên 200 triệu']]
            ],
            'Màn hình': [
                [['Thương hiệu', 'VSP', 'ViewSonic']],
                [['Giá bán', 'Dưới 3 triệu', 'Từ 3 đến 4 triệu']]
            ],
            'Bàn phím': [
                [['Thương hiệu', 'ASUS']],
                [['Giá bán', 'Từ 5 đến 6 triệu']]
            ],
            'Chuột + Lót chuột': [
                [['Thương hiệu', 'AKKO', 'Logitech', 'Razer', 'HyperWork']],
                [['Giá bán', 'Dưới 1 triệu', 'Từ 1 đến 5 triệu']]
            ],
            'Dịch vụ và thông tin khác': [
                [['Dịch vụ', 'Dịch vụ kỹ thuật tận nhà', 'Dịch vụ sửa chữa']],
                [['Chính sách', 'Chính sách &amp; bảng giá thu VGA qua sử dụng', 'Chính sách bảo hành', 'Chính sách giao hàng', 'Chính sách đổi trả']],
                [['Build PC']]
            ]
        };

        /* ===== XỬ LÝ ===== */
        var root = document.documentElement;
        var overlay = document.getElementById('dm-overlay');
        var X_HTML = '<span style="font-size:20px;line-height:1;margin-right:8px">✕</span>Danh mục';
        var side, panel, active, timer, SP;
        var btn, btnHTML, btnOpen = false, hovering = false;

        function norm(s) {
            return s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase().trim();
        }
        function enc(s) { return encodeURIComponent(s); }
        function url(cat, extra) { return SP + (SP.indexOf('?') > -1 ? '&' : '?') + 'loai=' + enc(cat) + (extra || ''); }

        // Bật/tắt nền tối
        function refresh() {
            var on = btnOpen || hovering;
            if (on) {
                var h = document.querySelector('header') || btn || side;
                overlay.style.top = Math.max(0, Math.round(h.getBoundingClientRect().bottom)) + 'px';
            }
            root.classList.toggle('dm-open', on);
        }

        function hide(now) {
            clearTimeout(timer);
            var run = function () {
                if (panel) panel.style.display = 'none';
                if (active) active.classList.remove('dm-active');
                active = null; hovering = false; refresh();
            };
            if (now) run(); else timer = setTimeout(run, 150);
        }

        function closeAll() {
            if (btnOpen && btn) btn.innerHTML = btnHTML;
            btnOpen = false; hide(true);
        }

        /* --- Nút "Danh mục": hiện ✕, cuộn tới cột trái (bắt click trước link của header) --- */
        function isMenuBtn(el) {
            if (!el || el.closest('.side, .mm, .dm-overlay')) return false;
            var t = norm(el.textContent);
            return el.id === 'btn-danhmuc' || (t.indexOf('danh muc') > -1 && t.length <= 20);
        }
        document.addEventListener('click', function (e) {
            var b = e.target.closest('a, button');
            if (!isMenuBtn(b)) return;
            e.preventDefault(); e.stopImmediatePropagation();
            if (!btnOpen) {
                btn = b; btnHTML = b.innerHTML; b.innerHTML = X_HTML;
                if (side) side.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else if (btn) {
                btn.innerHTML = btnHTML;
            }
            btnOpen = !btnOpen; refresh();
        }, true);
        overlay.addEventListener('click', closeAll);
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });

        /* --- Bảng hover --- */
        function render(cat) {
            var cols = MENU[cat], plain = PLAIN.indexOf(cat) > -1;
            var h = '<h3>' + cat + (cols && !plain ? '<a href="' + url(cat) + '">Xem tất cả ›</a>' : '') + '</h3>';
            if (!cols) return h + '<div class="mm-none">Chưa có thêm thông tin về danh mục này.</div>';

            h += '<div class="mm-cols">';
            cols.forEach(function (col) {
                h += '<div>';
                col.forEach(function (g) {
                    var t = g[0];
                    var href = t === 'Build PC' ? BUILDPC : plain ? '#' : url(cat, '&nhom=' + enc(t));
                    h += '<div class="mm-g"><a class="t" href="' + href + '">' + t + ' ›</a>';
                    g.slice(1).forEach(function (i) {
                        h += '<a class="i" href="' + (plain ? '#' : url(cat, '&muc=' + enc(i))) + '">' + i + '</a>';
                    });
                    h += '</div>';
                });
                h += '</div>';
            });
            return h + '</div>';
        }

        function show(a) {
            var name = a.textContent.trim();
            clearTimeout(timer);
            if (NO_HOVER.indexOf(name) > -1) { hide(true); return; }

            if (active) active.classList.remove('dm-active');
            active = a; a.classList.add('dm-active');

            panel.innerHTML = render(name);
            var r = side.getBoundingClientRect();
            var hero = document.querySelector('.hero');
            var edge = hero ? hero.getBoundingClientRect().right : r.right + 880;
            panel.style.left = (r.right + window.pageXOffset + 8) + 'px';
            panel.style.top = (r.top + window.pageYOffset) + 'px';
            panel.style.width = Math.max(560, edge - r.right - 8) + 'px';
            panel.style.minHeight = r.height + 'px';
            panel.style.display = 'block';
            hovering = true; refresh();
        }

        function init() {
            side = document.querySelector('.side');
            var links = side ? side.querySelectorAll('a') : [];
            if (!links.length) { console.log('[menu] KHONG THAY .side'); return; }

            SP = links[0].getAttribute('href') || '#';      // link trang Product lấy từ cột danh mục
            [].forEach.call(links, function (a) { a.setAttribute('href', url(a.textContent.trim())); });

            panel = document.createElement('div');
            panel.className = 'mm';
            document.body.appendChild(panel);

            side.addEventListener('mouseover', function (e) {
                var a = e.target.closest('a');
                if (a && side.contains(a)) show(a);
            });
            side.addEventListener('mouseleave', function () { hide(false); });
            panel.addEventListener('mouseenter', function () { clearTimeout(timer); });
            panel.addEventListener('mouseleave', function () { hide(false); });
            panel.addEventListener('click', function (e) {
                var a = e.target.closest('a');
                if (a && a.getAttribute('href') === '#') e.preventDefault();
            });
            console.log('[menu] OK: ' + links.length + ' muc');
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
    })();
    </script>
