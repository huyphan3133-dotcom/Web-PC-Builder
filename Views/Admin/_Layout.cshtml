<!DOCTYPE html>

<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản trị PC Builder</title>

    <!-- FontAwesome & Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <!-- Admin CSS -->
    <link rel="stylesheet" href="~/Content/admin.css">
</head>
<body>
    <div class="admin-wrapper d-flex">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar bg-dark text-white p-3">
            <div class="sidebar-header pb-3 mb-3 border-bottom border-secondary text-center">
                <!-- Đồng bộ logo chuẩn GearVN giống trang chủ -->
                <a href="@Url.Action("Index", "Home")" class="text-decoration-none">
                    <img src="~/Content/images/logo.png" alt="GEARVN" class="img-fluid" style="max-height: 35px;" onerror="this.onerror=null; this.src='https://via.placeholder.com/120x35?text=GEARVN';">
                </a>
                <div class="text-muted small mt-1 text-uppercase tracking-wider">Trang Quản Trị</div>
            </div>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item mb-2">
                    <a href="@Url.Action("ProductManager", "Admin")" class="nav-link text-white @(ViewBag.ActiveTab == "Product" ? "active bg-danger" : "")">
                        <i class="fa-solid fa-box me-2"></i>Quản lý sản phẩm
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a href="@Url.Action("OrderManager", "Admin")" class="nav-link text-white @(ViewBag.ActiveTab == "Order" ? "active bg-danger" : "")">
                        <i class="fa-solid fa-receipt me-2"></i>Quản lý đơn hàng
                    </a>
                </li>
            </ul>
            <hr class="border-secondary">
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-light w-100">
                <i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Về Trang chủ
            </a>
        </aside>

        <!-- Main Content -->
        <main class="admin-content flex-grow-1 p-4 bg-light">
            @RenderBody()
        </main>
    </div>

    <!-- JS Libraries -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <!-- Admin Custom JS -->
    <script src="~/Scripts/admin.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>