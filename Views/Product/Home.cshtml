@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
    <style>
        .dm-overlay {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, .5);
            z-index: 998;
            display: none;
        }

        .dm-panel {
            position: fixed;
            z-index: 999;
            display: none;
            width: 350px;
            max-width: calc(100vw - 32px);
            max-height: calc(100vh - 160px);
            overflow-y: auto;
            background: #fff;
            border-radius: 12px;
            padding: 10px 14px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .2);
        }

        .dm-open .dm-overlay, .dm-open .dm-panel {
            display: block;
        }

        .dm-panel a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 0;
            color: #333;
            text-decoration: none;
            font-size: 15px;
        }

            .dm-panel a:hover .dm-name {
                color: #d70018;
            }

        .dm-ico {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: #fde8ea;
            color: #d70018;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: none;
        }

            .dm-ico svg {
                width: 17px;
                height: 17px;
            }

        .dm-name {
            flex: 1;
        }

        .dm-chev {
            width: 16px;
            height: 16px;
            color: #999;
            flex: none;
        }
    </style>
</head>
<body>
    @*@{
            ViewBag.Title = "Danh mục sản phẩm";

            // Mock data viết thẳng trong view (không cần Model/.cs)
            var products = new[]
            {
            new { Id = 1, Name = "Laptop Asus TUF Gaming F15", Brand = "Asus", Price = 22990000L, Image = "/Content/images/p1.jpg", Description = "i5-12500H, RTX 4050, 16GB RAM, 512GB SSD" },
            new { Id = 2, Name = "Laptop MSI Thin GF63",       Brand = "MSI",  Price = 18990000L, Image = "/Content/images/p2.jpg", Description = "i5-12450H, RTX 4050, 16GB RAM, 512GB SSD" },
            new { Id = 3, Name = "PC GVN i5/RTX 5060",         Brand = "GVN",  Price = 23000000L, Image = "/Content/images/p3.jpg", Description = "i5-14400F, RTX 5060, 16GB RAM, 500GB SSD" },
            new { Id = 4, Name = "Laptop Asus ROG Strix G16",  Brand = "Asus", Price = 35990000L, Image = "/Content/images/p4.jpg", Description = "i7-13650HX, RTX 4060, 16GB RAM, 1TB SSD" }
        };
            System.Func<long, string> vnd = n => n.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + "đ";
        }

        @Html.Partial("_CartStyles")

        <div class="gv-container catalog">
            <svg width="0" height="0" style="position:absolute" aria-hidden="true">
                <symbol id="i-box" viewBox="0 0 24 24"><path d="M21 8 12 3 3 8v8l9 5 9-5zM3 8l9 5 9-5M12 13v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" /></symbol>
                <symbol id="i-chev" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></symbol>
            </svg>

            <div class="side-col">
                <nav class="cat-list" aria-label="Danh mục">
                    @foreach (var c in new[] { "Laptop", "Laptop Gaming", "PC GVN", "Main, CPU, VGA", "Case, Nguồn, Tản", "Ổ cứng, RAM, Thẻ nhớ", "Màn hình", "Bàn phím", "Chuột + Lót chuột", "Tai Nghe" })
                    {
                        <a href="#">
                            <span class="cat-ico"><svg><use href="#i-box" /></svg></span>
                            <span class="cat-name">@c</span>
                            <svg class="cat-chev"><use href="#i-chev" /></svg>
                        </a>
                    }
                </nav>

                <aside class="filter">
                    <h3>Thương hiệu</h3>
                    @foreach (var brand in products.Select(p => p.Brand).Distinct())
                    {
                        <label><input type="checkbox" class="filter-brand" value="@brand" /> @brand</label>
                    }

                    <h3>Mức giá</h3>
                    <label><input type="radio" name="price" class="filter-price" value="0-999999999" checked /> Tất cả</label>
                    <label><input type="radio" name="price" class="filter-price" value="0-20000000" /> Dưới 20 triệu</label>
                    <label><input type="radio" name="price" class="filter-price" value="20000000-30000000" /> 20 - 30 triệu</label>
                    <label><input type="radio" name="price" class="filter-price" value="30000000-999999999" /> Trên 30 triệu</label>
                </aside>
            </div>

            <section class="catalog-main">
                <h1>Danh mục sản phẩm</h1>
                <div class="product-grid" id="product-grid">
                    @foreach (var p in products)
                    {
                        <div class="product-card" data-brand="@p.Brand" data-price="@((long)p.Price)">
                            <a class="thumb" href="@Url.Action("Details", "Product", new { id = p.Id })">
                                <img src="@p.Image" alt="@p.Name" />
                            </a>
                            <h3><a href="@Url.Action("Details", "Product", new { id = p.Id })">@p.Name</a></h3>
                            <p class="desc">@p.Description</p>
                            <div class="price">@vnd(p.Price)</div>
                            <button type="button" class="btn btn-red btn-add-cart"
                                    data-id="@p.Id" data-name="@p.Name"
                                    data-price="@((long)p.Price)" data-image="@p.Image">
                                Thêm vào giỏ
                            </button>
                        </div>
                    }
                </div>
                <p id="no-result" class="empty" hidden>Không có sản phẩm phù hợp bộ lọc.</p>
            </section>
        </div>

        @Html.Partial("_CartScripts")*@
    <div class="dm-overlay" id="dm-overlay"></div>

    <nav class="dm-panel" id="dm-panel" aria-label="Danh mục sản phẩm">
        @foreach (var c in new[] { "Laptop", "Laptop Gaming", "PC GVN", "Main, CPU, VGA", "Case, Nguồn, Tản", "Ổ cứng, RAM, Thẻ nhớ", "Loa, Micro, Webcam", "Màn hình", "Bàn phím", "Chuột + Lót chuột", "Tai Nghe", "Ghế - Bàn", "Phần mềm, mạng", "Phụ kiện - Console", "Thu cũ đổi mới" })
        {
            <a href="#">
                <span class="dm-ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><path d="M21 8 12 3 3 8v8l9 5 9-5zM3 8l9 5 9-5M12 13v8" /></svg>
                </span>
                <span class="dm-name">@c</span>
                <svg class="dm-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
            </a>
        }
    </nav>

    <script>
        (function () {
            var header = document.querySelector('header');
            var btn = document.getElementById('btn-danhmuc') ||
                [].filter.call(document.querySelectorAll('a, button'), function (el) {
                    return el.textContent.trim() === 'Danh mục';
                })[0];
            if (!btn) return;

            var panel = document.getElementById('dm-panel');
            var overlay = document.getElementById('dm-overlay');
            var root = document.documentElement;
            var ICON_MENU = '<path d="M4 6h16M4 12h16M4 18h10"/>';
            var ICON_X = '<path d="M6 6l12 12M18 6 6 18"/>';

            var svg = btn.querySelector('svg');
            if (!svg) {
                btn.insertAdjacentHTML('afterbegin',
                    '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="margin-right:8px;vertical-align:middle"></svg>');
                svg = btn.querySelector('svg');
            }

            function place() {
                var bottom = Math.round((header || btn).getBoundingClientRect().bottom);
                overlay.style.top = bottom + 'px';
                panel.style.top = (bottom + 12) + 'px';
                panel.style.left = Math.max(16, (window.innerWidth - 1200) / 2 + 16) + 'px';
            }

            function setOpen(open) {
                if (open) place();
                root.classList.toggle('dm-open', open);
                svg.innerHTML = open ? ICON_X : ICON_MENU;
            }

            btn.addEventListener('click', function (e) {
                e.preventDefault();
                setOpen(!root.classList.contains('dm-open'));
            });
            panel.addEventListener('click', function (e) {
                if (e.target.closest('a')) { e.preventDefault(); setOpen(false); }
            });
            overlay.addEventListener('click', function () { setOpen(false); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
            window.addEventListener('resize', function () { if (root.classList.contains('dm-open')) place(); });
        })();
    </script>

</body>
</html>
